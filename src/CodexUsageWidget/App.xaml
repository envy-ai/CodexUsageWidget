<Application x:Class="CodexUsageWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E6202329" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#405B6574" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF89919E" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FF353A43" />
    </Application.Resources>
</Application>
