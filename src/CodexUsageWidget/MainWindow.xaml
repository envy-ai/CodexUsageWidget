<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexUsageWidget"
        Title="Codex usage"
        Width="330"
        Height="98"
        MinWidth="220"
        MinHeight="66"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <local:RemainingBrushConverter x:Key="RemainingBrushConverter" />
        <DropShadowEffect x:Key="WidgetTextShadow" x:Shared="False"
                          Color="Black" BlurRadius="2" Direction="315"
                          ShadowDepth="1" Opacity="0.75" RenderingBias="Performance" />
        <DropShadowEffect x:Key="WidgetBarShadow" x:Shared="False"
                          Color="Black" BlurRadius="3" Direction="270"
                          ShadowDepth="1" Opacity="0.7" RenderingBias="Performance" />
        <Style x:Key="MeterProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect" Value="{StaticResource WidgetBarShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Border x:Name="PART_Track" CornerRadius="2.5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Effect" Value="{StaticResource WidgetTextShadow}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HoverToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Effect" Value="{StaticResource WidgetTextShadow}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Pin above other apps" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FF54C6FF" />
                    <Setter Property="ToolTip" Value="Unpin" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="HoverSurface"
            Background="Transparent"
            MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Grid>
            <Border Margin="1"
                IsHitTestVisible="False"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=HoverSurface}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.45" />
            </Border.Effect>
        </Border>

        <Grid Margin="13,8,13,7">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Effect" Value="{StaticResource WidgetTextShadow}" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" Text="5 HOUR" />
                <ProgressBar Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{Binding FiveHourRemaining, Mode=OneWay, TargetNullValue=0}"
                             Foreground="{Binding FiveHourRemaining, Converter={StaticResource RemainingBrushConverter}}"
                             Style="{StaticResource MeterProgressBarStyle}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding FiveHourRemaining, Converter={StaticResource RemainingBrushConverter}}"
                           Text="{Binding FiveHourPercentageText, TargetNullValue=—}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" Text="WEEK" />
                <ProgressBar Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{Binding WeeklyRemaining, Mode=OneWay, TargetNullValue=0}"
                             Foreground="{Binding WeeklyRemaining, Converter={StaticResource RemainingBrushConverter}}"
                             Style="{StaticResource MeterProgressBarStyle}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding WeeklyRemaining, Converter={StaticResource RemainingBrushConverter}}"
                           Text="{Binding WeeklyPercentageText, TargetNullValue=—}" />
            </Grid>

            <Grid Grid.Row="4" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,4,0"
                           VerticalAlignment="Center" TextAlignment="Left"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding FiveHourResetText}" />
                <TextBlock Grid.Column="1" Margin="4,0,0,0"
                           VerticalAlignment="Center" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding WeeklyResetText}" />
            </Grid>

            <TextBlock Grid.Row="6" Margin="0,0,14,0" VerticalAlignment="Bottom"
                       FontFamily="Consolas" FontSize="9"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}" />
        </Grid>

        <StackPanel Margin="0,3,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Panel.ZIndex="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=HoverSurface}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ToggleButton x:Name="PinButton"
                          Style="{StaticResource HoverToggleButtonStyle}"
                          Click="PinButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE718;" />
            </ToggleButton>
            <Button x:Name="CloseButton"
                    Style="{StaticResource HoverButtonStyle}"
                    FontFamily="Consolas"
                    FontSize="14"
                    ToolTip="Exit"
                    Click="CloseButton_Click"
                    Content="×" />
        </StackPanel>

        <Thumb x:Name="ResizeGrip"
               Width="14" Height="14"
               Margin="0,0,5,5"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Panel.ZIndex="2"
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Style>
                <Style TargetType="Thumb">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M 2,12 L 12,2 M 6,12 L 12,6 M 10,12 L 12,10"
                                          Stroke="{StaticResource MutedTextBrush}"
                                          StrokeThickness="1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=HoverSurface}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Thumb.Style>
        </Thumb>

        </Grid>

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="Refresh now" Click="RefreshNow_Click" />
                <MenuItem x:Name="StartWithWindowsMenuItem"
                          Header="Start with Windows"
                          IsCheckable="True"
                          Click="StartWithWindows_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</Window>
